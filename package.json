    "test:webkit:diagnostic": "node scripts/webkit-diagnostic.mjs"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "next": "16.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/d3-geo": "3.1.0",
    "@types/node": "24.13.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.0",
    "playwright": "1.62.1",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.7",
    "typescript": "5.5.4",
    "vitest": "4.1.10"
  },
