{
  "name": "qin-han-war-atlas",
  "version": "2.6.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs && npm run check:static-budget",
    "preflight:historical-gis": "node scripts/preflight-historical-gis.mjs",
    "check:static-budget": "node scripts/check-static-budget.mjs",
    "audit:release-candidate": "node scripts/release-candidate-audit.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
